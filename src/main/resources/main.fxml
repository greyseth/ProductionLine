<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <top>
      <FlowPane alignment="CENTER_RIGHT" columnHalignment="CENTER" prefHeight="4.0" prefWidth="200.0" style="-fx-background-color: lightgrey;" BorderPane.alignment="CENTER">
         <children>
            <Label text="OracleProductions Control Panel">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </FlowPane>
   </top>
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" spacing="10.0" style="-fx-background-color: lightgrey;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="button_AddProduct" mnemonicParsing="false" text="Add Product" />
            <Button fx:id="button_ProductionCatalog" layoutX="20.0" layoutY="20.0" mnemonicParsing="false" text="Product Catalog" />
            <Button fx:id="button_Statistics" layoutX="20.0" layoutY="55.0" mnemonicParsing="false" text="Statistics" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <FlowPane fx:id="container_Welcome" alignment="CENTER" prefHeight="200.0" prefWidth="200.0" visible="false">
               <children>
                  <Label text="Welcome, admin">
                     <font>
                        <Font name="System Bold Italic" size="24.0" />
                     </font>
                  </Label>
               </children>
            </FlowPane>
            <VBox fx:id="container_AddProduct" prefHeight="200.0" prefWidth="100.0" spacing="15.0" visible="false">
               <children>
                  <Label text="Add Product">
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <HBox layoutX="10.0" layoutY="65.0" prefWidth="200.0" spacing="25.0">
                     <children>
                        <Label text="Product Type" />
                        <ComboBox fx:id="input_ProductType" prefWidth="150.0" HBox.hgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets left="15.0" right="15.0" />
                     </padding>
                  </HBox>
                  <StackPane>
                     <children>
                        <VBox fx:id="container_AudioPlayerForm" spacing="15.0" visible="false">
                           <children>
                              <HBox prefWidth="200.0" spacing="25.0">
                                 <children>
                                    <Label text="Audio Player Name" />
                                    <TextField fx:id="input_AudioPlayerName" HBox.hgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets left="15.0" right="15.0" />
                                 </padding>
                              </HBox>
                              <HBox prefWidth="200.0" spacing="25.0">
                                 <children>
                                    <Label text="Audio Specification" />
                                    <TextField fx:id="input_AudioSpecification" HBox.hgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets left="15.0" right="15.0" />
                                 </padding>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox fx:id="container_ScreenForm" layoutX="10.0" layoutY="10.0" spacing="15.0" visible="false">
                           <children>
                              <HBox prefWidth="200.0" spacing="25.0">
                                 <children>
                                    <Label text="Screen Resolution" />
                                    <TextField fx:id="input_ScreenResolution" HBox.hgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets left="15.0" right="15.0" />
                                 </padding>
                              </HBox>
                              <HBox prefWidth="200.0" spacing="25.0">
                                 <children>
                                    <Label text="Refresh Rate" />
                                    <TextField fx:id="input_RefreshRate" HBox.hgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets left="15.0" right="15.0" />
                                 </padding>
                              </HBox>
                              <HBox layoutX="10.0" layoutY="50.0" prefWidth="200.0" spacing="25.0">
                                 <children>
                                    <Label text="Response Time" />
                                    <TextField fx:id="input_ResponseTime" HBox.hgrow="ALWAYS" />
                                 </children>
                                 <padding>
                                    <Insets left="15.0" right="15.0" />
                                 </padding>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <HBox fx:id="container_ProductQuantity" prefWidth="200.0" spacing="25.0" visible="false">
                     <children>
                        <Label text="Product Quantity" />
                        <TextField fx:id="input_ProductQuantity" HBox.hgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets left="15.0" right="15.0" />
                     </padding>
                  </HBox>
                  <Button fx:id="button_AddProduct_Save" mnemonicParsing="false" text="Add New Product" visible="false">
