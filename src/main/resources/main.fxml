                        <Insets left="15.0" />
                     </VBox.margin>
                  </Button>
                  <Label fx:id="display_AddProduct_Log" text="Product has been added!" textFill="#00ff09" visible="false">
                     <VBox.margin>
                        <Insets left="15.0" />
                     </VBox.margin>
                     <font>
                        <Font name="System Italic" size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox fx:id="container_ProductCatalog" layoutX="10.0" layoutY="10.0" prefHeight="200.0" prefWidth="100.0" spacing="10.0" visible="false">
               <children>
                  <Label text="Full Product Catalog">
                     <VBox.margin>
                        <Insets left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TableView fx:id="table_CatalogTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="table_CatalogTable_No" prefWidth="37.0" text="No." />
                        <TableColumn fx:id="table_CatalogTable_ProductType" prefWidth="106.0" text="Product Type" />
                      <TableColumn fx:id="table_CatalogTable_Name" prefWidth="131.0" text="Name" />
                        <TableColumn fx:id="table_CatalogTable_Classifications" prefWidth="203.0" text="Classifications" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
            <VBox fx:id="container_Statistics" prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-border-color: white;">
               <children>
                  <Label text="Production Statistics">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
                  <ScrollPane style="-fx-border-color: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox spacing="10.0">
                           <children>
                              <Label fx:id="display_ProductsAdded" text="Total Products Added: " />
                              <VBox>
                                 <children>
                                    <Label text="Unique Item Production:" />
                                    <TableView fx:id="table_UniqueItems" prefHeight="200.0" prefWidth="447.0">
                                      <columns>
                                        <TableColumn fx:id="table_UniqueItems_Name" prefWidth="235.0" text="Name" />
                                        <TableColumn fx:id="table_UniqueItems_Amount" prefWidth="138.0" text="Amount" />
                                      </columns>
                                    </TableView>
                                 </children>
                              </VBox>
                              <Label fx:id="display_UniqueItems" layoutX="10.0" layoutY="10.0" text="Total Unique Items: " />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
